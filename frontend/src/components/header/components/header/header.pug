mixin header(props = {})
    -
        const messengers = [
            {
                icon: 'whatsapp',
                href: 'https://wa.me/79052327888',
                ariaLabel: 'Перейти в мессенджер WhatsApp'
            },
            {
                icon: 'telegram',
                href: 'https://telegram.me/Luonidovna',
                ariaLabel: 'Перейти в мессенджер Telegram'
            }
        ]

    header.header&attributes(attributes)
        .header__wrapper.header__wrapper_desktop
            a.header__logo-link.header__backdrop(
                href="#",
                aria-label="Прокрутить страницу к началу"
            )
                +logo.header__logo

            .header__backdrop.header__backdrop_nav-bar
                +nav-bar.p6

            .header__backdrop.header__backdrop_buttons
                each messenger in messengers
                    +link-button(messenger)

                +button({ text: 'Начать заниматься', href: '#feedback' }).header__button

        .header__wrapper.header__wrapper_tablet
            .header__backdrop
                a.header__logo-link(
                    href="#",
                    aria-label="Прокрутить страницу к началу"
                )
                    +logo.header__logo

                .header__backdrop.header__backdrop_buttons
                    each messenger in messengers
                        +link-button(messenger)

                    +button({ text: 'Начать заниматься', href: '#feedback' }).header__button

            +burger.header__burger

        +nav-bar.header__nav-bar.visually-hidden.h3-m
