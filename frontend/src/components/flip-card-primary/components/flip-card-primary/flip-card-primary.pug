mixin flip-card-primary(props = {})
    template.flip-card-primary-template
        article.flip-card-primary
            .flip-card-primary__wrapper
                .flip-card-primary__front
                    +img.flip-card-primary__img

                    .flip-card-primary__header
                        h3.h3.flip-card-primary__title
                            span.flip-card-primary__title-text

                            +link({ hasUnderline: true }).flip-card-primary__title-link

                        //- Костыль
                        +icon('person').flip-card-primary__icon.flip-card-primary__icon_person
                        +icon('people').flip-card-primary__icon.flip-card-primary__icon_people

                    ul.flip-card-primary__services-list

                .flip-card-primary__back
                    h3.h3.flip-card-primary__title-back
                        span.flip-card-primary__title-back-text

                        +link({ hasUnderline: true }).flip-card-primary__title-back-link

                    ul.flip-card-primary__price-list
