mixin section(props = {})
    -
        const theme = props.theme || 'dark'

    section.section&attributes(attributes)(class!=`section_theme_${theme}`)
        .section__wrapper(class=props.classNames && props.classNames.wrapper)
            if props.title
                +section-title({ title: props.title, theme, hasAnimation: props.hasTitleAnimation })

            if props.subtitle
                p.section__subtitle.h4!= props.subtitle

            block
