mixin section-diplomas(props = {})
    +section({ theme: 'light', title: { className: 'section-diplomas__title', startText: 'Дипломы ', endText: 'и\u00a0сертификаты' } }).section-diplomas
        +folder({ tabs: [{ label: 'Дипломы', dataLabel: 'degrees', imgsNum: 2, checked: true }, { label: 'Сертификаты', dataLabel: 'diplomas', imgsNum: 2 }, { label: 'Грамоты', dataLabel: 'certificates', imgsNum: 3 }, { label: 'Медали', dataLabel: 'awards', imgsNum: 4 }] }).section-diplomas__folder
