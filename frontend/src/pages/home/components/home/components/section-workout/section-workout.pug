mixin section-workout(props = {})
    +section({ title: { startText: 'Виды тренировок' } })#workout
        ul.section-workout__cards-list
            li.section-workout__cards-list-item
                +more-info-card({ title: 'Подробнее об онлайн сопровождении', text: 'Узнать больше', icon: 'book' })
