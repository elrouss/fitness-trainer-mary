mixin section-activities(props = {})
    +section({ title: { align: 'center', startText: 'Мероприятия' } })#activities.section-activities
        ul.section-activities__tabs
            li
                +tab({ label: 'Прошедшие', name: 'activities', value: 'past', borderRadiusPosition: 'left' }).section-activities__tab
            li
                +tab({ label: 'Будущие', name: 'activities', value: 'future', checked: true, borderRadiusPosition: 'right' }).section-activities__tab

        ul.section-activities__list

        +button({ text: 'Показать еще', theme: 'light' }).section-activities__more-button
