mixin section-hero(props = {})
    section.section-hero
        .section-hero__wrapper
            h1.h1.section-hero__title Ваш заботливый фитнес-тренер

            .section-hero__accent-words
                p.p5.section-hero__motto Для тех, кто хочет сделать спорт своей рутиной, но&nbsp;постоянно спотыкается

                h2.h1.section-hero__accent-word Мария

            .section-hero__bg-img

            +button({ text: 'Начать заниматься', href: '#feedback' }).section-hero__button
