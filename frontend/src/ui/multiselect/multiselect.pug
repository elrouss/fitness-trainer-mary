mixin multiselect(props = {})
    .multiselect.p6&attributes(attributes)
        span.multiselect__label!= props.label

        .multiselect__wrapper
            .multiselect__input-container
                span.multiselect__input-placeholder!= props.placeholder

                span.multiselect__input-icon-wrapper
                    +icon('arrow-down-bold')

            ul.multiselect__select.visually-hidden

        +multiselect-option

        +multiselect-tab
