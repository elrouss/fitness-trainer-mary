mixin checkbox(props = {})
    label.checkbox.p7&attributes(attributes)
        input.checkbox__input(type="checkbox")

        if props.labelPosition == 'left'
            span.checkbox__label
                block

        span.checkbox__box-wrapper
            span.checkbox__box

            +icon('checkmark').checkbox__icon

        if props.labelPosition == 'right'
            span.checkbox__label(class=props.required && "checkbox__label_required")
                block
