mixin input(props = {})
    .input.p6&attributes(attributes)
        label.input__label(for=props.id)
            span.input__label-text(
                class=props.required && "input__label-text_required"
            )!= props.label

        .input__input-wrapper
            input.input__input.p6(
                id=props.id,
                type=props.type || "text",
                name=props.name,
                placeholder=props.placeholder,
                autocomplete=props.autocomplete,
                required=props.required
            )

            button.input__icon-status.hidden

            +tooltip.input__tooltip
