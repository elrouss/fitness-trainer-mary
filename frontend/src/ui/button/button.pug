mixin button(props = {})
    -
        const isButton = !props.href;
        const tag = isButton ? 'button' : 'a';

    #{tag}.button&attributes(attributes)(
        class=`button_theme_${props.theme || 'default'}`,
        type=isButton ? props.type || "button" : undefined,
        href=props.href
    )
        if isButton
            +spinner('spinner').button__spinner

        span.h4.button__text= props.text
