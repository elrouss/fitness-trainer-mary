mixin outline-button(props = {})
    button.outline-button&attributes(attributes)(
        class!=`outline-button_theme_${props.theme || 'light'}`,
        class=props.icon ? undefined : "outline-button_padding_big"
    )
        if props.icon
            span.outline-button__icon-wrapper
                +icon(props.icon)

        span.outline-button__text.h4!= props.text
